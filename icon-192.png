<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1a0800"/>
      <stop offset="100%" stop-color="#2d1400"/>
    </linearGradient>
    <linearGradient id="bolt" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4570A"/>
      <stop offset="100%" stop-color="#F4894A"/>
    </linearGradient>
  </defs>
  <!-- Sfondo -->
  <rect width="512" height="512" rx="115" fill="url(#bg)"/>
  <!-- Bolt -->
  <polygon points="280,80 210,240 248,240 222,420 340,255 298,255 325,80" fill="url(#bolt)"/>
  <!-- FO bianco -->
  <text x="256" y="468" text-anchor="middle"
    font-family="-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif"
    font-size="88" font-weight="700" fill="white" letter-spacing="-3">FO<tspan fill="#F4894A">fit</tspan></text>
</svg>
